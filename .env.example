# ==========================================
# myStock 알림 설정 환경 변수 (.env)
# ==========================================

# 1. 텔레그램 봇 알림 설정 (선택)
# - BotFather를 통해 발급받은 BOT Token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# - @userinfobot 등을 통해 확인한 본인의 Chat ID
TELEGRAM_CHAT_ID=123456789

# 2. 슬랙 웹훅 알림 설정 (선택)
# - Slack App > Incoming Webhooks에서 생성한 URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# 3. 디스코드 웹훅 알림 설정 (선택)
# - Discord 채널 설정 > 연동 > 웹후크 생성 URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/0000/XXXX
